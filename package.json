{
  "name": "tiktok-poster",
  "productName": "TikTok Poster",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for posting and scheduling videos and photo carousels to TikTok and Instagram",
  "license": "MIT",
  "author": "abehan7",
  "repository": {
    "type": "git",
    "url": "https://github.com/abehan7/tiktok-poster.git"
  },
  "homepage": "https://github.com/abehan7/tiktok-poster#readme",
  "main": "out/main/index.js",
  "bin": {
    "tiktok-poster": "out/cli/index.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:cli",
    "build:cli": "vite build -c vite.cli.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --mac --dir",
    "dist:dmg": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
